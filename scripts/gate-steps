#!/usr/bin/env bash
# Gate steps run inside the build container by scripts/check (docs/plan.md §8). Each is fatal.
# `--quick` runs only clippy and the tests, for scripts/quick: the same commands as the gate's.
set -euo pipefail
cd "$(dirname "$0")/.."
step() { printf '\n== gate: %s\n' "$*"; }
quick=0
if [[ ${1:-} == --quick ]]; then quick=1; fi

if ((!quick)); then
    step "format"
    cargo fmt --all --check
fi

step "clippy"
# -D warnings does not cover clippy's own configuration warnings (a disallowed-methods path that
# no longer resolves only warns), so any warning in the output fails the step.
clippy_log=target/gate/clippy.log
mkdir -p target/gate
cargo clippy --workspace --exclude gbk-markdown-lint-canary --all-targets --locked -- -D warnings \
    2>&1 | tee "$clippy_log"
if grep -q '^warning' "$clippy_log"; then
    echo "gate: clippy printed warnings (see above)" >&2
    exit 1
fi

if ((quick)); then
    step "tests"
    cargo nextest run --locked --no-fail-fast
    exit 0
fi

step "lint canary"
scripts/lint-canary

step "boundaries"
scripts/check-boundaries

step "push guard"
.claude/hooks/test-guard-push

step "wait guard"
.claude/hooks/test-guard-wait

step "tests"
cargo nextest run --locked --no-fail-fast
scripts/check-test-floor

step "cargo-deny"
cargo deny --locked check

step "release build"
cargo build --release --locked

step "grammar licences"
scripts/check-grammars

step "third-party notices"
scripts/third-party --check

step "install"
scripts/test-install

step "smoke"
scripts/gen-fixtures >/dev/null
scripts/smoke
