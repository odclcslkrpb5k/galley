#!/usr/bin/env bash
# Smoke run (docs/plan.md §8, gate step 8): opens every fixture in the release build under Xvfb,
# checks it reaches a first frame and the work counters hold, and saves a screenshot of each to
# target/docker/screens/<tree hash>/ (from scripts/check; "adhoc" otherwise), so each milestone's
# screens survive later runs for before/after comparison. Runs inside the build container.
set -euo pipefail
cd "$(dirname "$0")/.."
if [[ -z "${DISPLAY:-}" ]]; then
  exec xvfb-run -a -s "-screen 0 1280x1024x24" "$0" "$@"
fi
export NO_AT_BRIDGE=1 GTK_A11Y=none XDG_RUNTIME_DIR=/tmp/xdg-runtime
mkdir -p -m 700 "$XDG_RUNTIME_DIR"

bin=${CARGO_TARGET_DIR:-target}/release/gbk-markdown
screens=${CARGO_TARGET_DIR:-target}/screens/${GATE_TREE:-adhoc}
mkdir -p "$screens"

fixtures=(crates/core/tests/data/corpus/*/input.md target/fixtures/{readme-200kb,list-1mb,table-1mb,wide-table,code-1mb,huge-line,huge-cells,huge-heading}.md)
# Scrolled end to end: steady scrolling must find every leaf laid out (plan §6).
scrolled=(target/fixtures/readme-200kb.md target/fixtures/list-1mb.md target/fixtures/table-1mb.md target/fixtures/wide-table.md crates/core/tests/data/corpus/_synthetic-features/input.md)
# Height worker against main-thread layout: every height must match exactly (plan §4.5).
checked=(crates/core/tests/data/corpus/_synthetic-features/input.md crates/core/tests/data/corpus/sharkdp__bat/input.md target/fixtures/readme-200kb.md target/fixtures/table-1mb.md)

# Work before the first frame, judged independently of the view's own layout window (which
# grading itself could never fail): the text Pango may be given for a 1000 px window. Two screens
# of dense 9 px text are under 20 KiB; a paragraph or leaf bigger than the budget fails here,
# which is the point.
first_frame_byte_budget=32768
# Layouts before the first frame: bytes miss a table's many small cells (each a layout, with
# its own font and attribute setup). table-1mb's first screen and column sample are ~300.
first_frame_layout_budget=1000
# A first frame (since main) later than this is a freeze, not slowness (the huge-* fixtures once took 68 s
# or never arrived); normal fixtures take well under a second here.
first_frame_time_budget_us=5000000

fail=0 n=0
for fixture in "${fixtures[@]}"; do
  name=$(basename "$(dirname "$fixture")")
  [[ "$name" == fixtures ]] && name=$(basename "$fixture" .md)
  status=0
  out=$(timeout 60 "$bin" --exit-after-first-frame --screenshot="$screens/$name.png" "$fixture" 2>&1) || status=$?
  if ((status)); then
    # 124 is timeout's; above 128, a signal (128 + its number).
    echo "smoke: $name: no first frame (exit status $status): $out" >&2
    fail=1
    continue
  fi
  report=$(grep -E '^first_frame_us=' <<<"$out" || true)
  bytes=$(grep -oE 'bytes_laid_out_before_first_frame=[0-9]+' <<<"$report" | cut -d= -f2 || true)
  time_us=$(grep -oE 'since_main_us=[0-9]+' <<<"$report" | cut -d= -f2 || true)
  # The leading space: bytes_laid_out_before_first_frame ends the same way.
  layouts=$(grep -oE ' laid_out_before_first_frame=[0-9]+' <<<"$report" | cut -d= -f2 || true)
  # Each must be one number: a pattern matching twice would make the comparisons below
  # arithmetic errors, which a condition takes as false (a check that cannot fail).
  if ! [[ "$bytes" =~ ^[0-9]+$ && "$time_us" =~ ^[0-9]+$ && "$layouts" =~ ^[0-9]+$ ]]; then
    echo "smoke: $name: no probe report in: $out" >&2
    fail=1
  elif ! grep -q 'renderer=GskCairoRenderer' <<<"$report"; then
    echo "smoke: $name: the default renderer is not Cairo: $report" >&2
    fail=1
  elif ((time_us > first_frame_time_budget_us)); then
    echo "smoke: $name: first frame after ${time_us} us; budget $first_frame_time_budget_us" >&2
    fail=1
  elif ((bytes > first_frame_byte_budget)); then
    echo "smoke: $name: gave Pango $bytes bytes before the first frame; budget $first_frame_byte_budget" >&2
    fail=1
  elif ((layouts > first_frame_layout_budget)); then
    echo "smoke: $name: made $layouts layouts before the first frame; budget $first_frame_layout_budget" >&2
    fail=1
  elif [[ ! -s "$screens/$name.png" ]]; then
    echo "smoke: $name: no screenshot" >&2
    fail=1
  fi
  n=$((n + 1))
done
if ((n == 0)); then echo "smoke: no fixtures ran" >&2; exit 1; fi

for fixture in "${scrolled[@]}"; do
  if ! out=$(timeout 300 "$bin" --bench-scroll "$fixture" 2>&1); then
    echo "smoke: scroll $fixture failed: $out" >&2
    fail=1
    continue
  fi
  frames=$(grep -oE 'layouts_in_scroll_frames=[0-9]+' <<<"$out" | cut -d= -f2 || true)
  if [[ "$frames" != 0 ]]; then
    echo "smoke: scroll $fixture laid out ${frames:-?} leaves inside frames; must be 0" >&2
    fail=1
  fi
  n=$((n + 1))
done

# probe_run VAR ARGS...: a probe run that must exit 0 with a first-frame report; its output
# goes in VAR ("" and a failure recorded otherwise). Not called as $(...): a subshell would
# lose the failure and the count.
probe_run() {
  local into=$1 status=0 out
  shift
  out=$(timeout 60 "$bin" --exit-after-first-frame "$@" 2>&1) || status=$?
  n=$((n + 1))
  if ((status)) || ! grep -q '^first_frame_us=' <<<"$out"; then
    echo "smoke: $* exited with status $status: $out" >&2
    fail=1
    out=""
  fi
  printf -v "$into" '%s' "$out"
}
field() { grep -oE "$1=[^ ]+" <<<"$2" | cut -d= -f2- || true; }

# Links: the widget finds the link under a point at the top, and after --anchor opened the
# document far down (gen-fixtures writes links.md so both points are on a link). Clicking the
# top link shows the leaf --anchor=end opens at.
links=target/fixtures/links.md
probe_run top --link-at=120,44 "$links"
probe_run anchored --anchor=end --link-at=120,44 --click-at=1,1 "$links"
probe_run clicked --click-at=120,44 "$links"
end_leaf=$(field top_leaf "$anchored")
if [[ "$(field link_at "$top")" != leaf:* ]]; then
  echo "smoke: --link-at at the top found no link inside the document: $top" >&2
  fail=1
elif [[ "$(field link_at "$anchored")" != uri:https://example.com/end ]]; then
  echo "smoke: --link-at after --anchor=end found no link to https://example.com/end: $anchored" >&2
  fail=1
elif [[ -z "$end_leaf" || "$(field top_leaf "$clicked")" != "$end_leaf" ]]; then
  echo "smoke: clicking the top link did not show the leaf --anchor=end opens at ($end_leaf): $clicked" >&2
  fail=1
fi

# A summary opens its <details>: the document is taller than after a click on nothing.
details=target/fixtures/details.md
probe_run opened --click-at=120,44 "$details"
probe_run missed --click-at=120,900 "$details"
opened_height=$(field document_height "$opened")
missed_height=$(field document_height "$missed")
if [[ "$(field clicked "$opened")" != summary:0 || "$(field clicked "$missed")" != none ]] ||
  ! [[ "$opened_height" =~ ^[0-9]+$ && "$missed_height" =~ ^[0-9]+$ ]] ||
  ((opened_height <= missed_height)); then
  echo "smoke: clicking the summary did not open its details: $opened / $missed" >&2
  fail=1
fi

# The GL fallback (--renderer=gl): it must really be GL, reach a first frame and scroll without
# layout in frames.
gl_fixture=target/fixtures/readme-200kb.md
out=$(timeout 60 "$bin" --renderer=gl --exit-after-first-frame "$gl_fixture" 2>&1 || true)
if ! grep -q 'renderer=GskGLRenderer' <<<"$out"; then
  echo "smoke: --renderer=gl did not render with GL: $out" >&2
  fail=1
fi
out=$(timeout 300 "$bin" --renderer=gl --bench-scroll "$gl_fixture" 2>&1 || true)
if ! grep -q 'layouts_in_scroll_frames=0' <<<"$out"; then
  echo "smoke: --renderer=gl scroll laid out leaves inside frames: $out" >&2
  fail=1
fi
n=$((n + 2))

for fixture in "${checked[@]}"; do
  out=$(timeout 300 "$bin" --check-heights "$fixture" 2>&1 || true)
  mismatches=$(grep -oE 'height_mismatches=[0-9]+' <<<"$out" | cut -d= -f2 || true)
  if [[ "$mismatches" != 0 ]]; then
    echo "smoke: heights $fixture: ${mismatches:-no report} mismatches between worker and layout: $out" >&2
    fail=1
  fi
  n=$((n + 1))
done

if ((fail)); then exit 1; fi
echo "smoke: $n runs ok; screenshots in $screens"
