#!/usr/bin/env bash
# Structural rules no compiler checks (docs/plan.md §3, §7). Runs inside the build container.
set -euo pipefail
cd "$(dirname "$0")/.."
fail=0

# Every workspace member takes the workspace lints; one that does not is silently unlinted.
for manifest in crates/*/Cargo.toml; do
  if ! grep -qzE '\[lints\][[:space:]]+workspace = true' "$manifest"; then
    echo "boundaries: $manifest lacks [lints] workspace = true" >&2
    fail=1
  fi
done

# confined NAME ALLOWED: the crate NAME is used only in files under ALLOWED. comrak lives in one
# private module of core (cargo-deny refuses a direct dependency from any other crate, but cannot
# see core re-exporting comrak types; this can); syntect and its grammars in the highlighter.
confined() {
  local name=$1 allowed=$2 status=0 matches code_matches file
  # grep exits 1 for no match, which is the passing case; 2 is an error and must fail.
  matches=$(grep -rnw "$name" crates/*/src) || status=$?
  if ((status > 1)); then
    echo "boundaries: grep failed ($status)" >&2
    exit 1
  fi
  # Code only: a comment may name it (for example "no comrak here").
  code_matches=$(grep -vE '^[^:]+:[0-9]+:[[:space:]]*//' <<<"$matches" || true)
  while read -r file; do
    if [[ -n "$file" && "$file" != "$allowed"* ]]; then
      echo "boundaries: $file uses $name; only $allowed may" >&2
      fail=1
    fi
  done < <(cut -d: -f1 <<<"$code_matches" | sort -u)
}
confined comrak crates/core/src/parse/
confined syntect crates/app/src/highlighter.rs
confined two_face crates/app/src/highlighter.rs

# One `unsafe` exception in the program: main.rs sets GTK's renderer through the environment
# (docs/plan.md §4.4). `unsafe_code` is deny, so any other unsafe needs its own lint exception;
# there must be exactly one, and every unsafe block must be in main.rs. (The lint canary is
# excluded: it holds a deliberate violation.)
code_lines() { grep -rnE "$1" crates/*/src crates/*/tests crates/*/examples 2>/dev/null |
  grep -v '^crates/lint-canary/' | grep -vE '^[^:]+:[0-9]+:[[:space:]]*//' || true; }
exceptions=$(code_lines '\bunsafe_code\b')
if [[ $(grep -c . <<<"$exceptions") != 1 || "$exceptions" != crates/app/src/main.rs:* ]]; then
  echo "boundaries: expected exactly one unsafe_code exception, in crates/app/src/main.rs; found:" >&2
  echo "${exceptions:-none}" >&2
  fail=1
fi
outside=$(code_lines '\bunsafe[[:space:]]*(\{|fn|impl|trait|extern)' | grep -v '^crates/app/src/main.rs:' || true)
if [[ -n "$outside" ]]; then
  echo "boundaries: unsafe outside crates/app/src/main.rs:" >&2
  echo "$outside" >&2
  fail=1
fi

if ((fail)); then exit 1; fi
echo "boundaries: ok"
