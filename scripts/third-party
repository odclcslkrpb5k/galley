#!/usr/bin/env python3
"""THIRD-PARTY-NOTICES.md: the licences of everything built into the release binary.

    scripts/third-party           write it
    scripts/third-party --check   fail if the committed one is not what would be written (gate)

Runs in the build container after the release build. The Rust crates are those linked into the
binary (normal dependencies on x86_64 Linux, from `cargo tree`), each with the licence and
NOTICE files of its package; identical texts are printed once, with the crates that carry
them. The grammars are those shipped (build.rs writes their listing) and the notices that
listing lacks (crates/app/grammar-notices-extra.md). GTK and the other system libraries are
linked dynamically and not distributed with the binary.
"""

import glob
import json
import os
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
TARGET = Path(os.environ.get("CARGO_TARGET_DIR", ROOT / "target"))
OUT = ROOT / "THIRD-PARTY-NOTICES.md"
LICENCE_FILE = re.compile(r"^(licen[cs]e|copying|notice|copyright)([-._].*)?$", re.IGNORECASE)


def cargo(*args):
    return subprocess.run(["cargo", *args], cwd=ROOT, check=True, capture_output=True, text=True).stdout


def crates():
    """(name, version, licence, directory) of every crate linked into the binary."""
    tree = cargo("tree", "--locked", "-p", "galley", "-e", "normal",
                 "--target", "x86_64-unknown-linux-gnu", "--prefix", "none",
                 "--format", "{p}\t{l}")
    metadata = json.loads(cargo("metadata", "--locked", "--format-version", "1"))
    where = {(p["name"], p["version"]): Path(p["manifest_path"]).parent for p in metadata["packages"]}
    found = {}
    for line in tree.splitlines():
        # `cargo tree` marks a crate shown before with "(*)".
        package, _, licence = line.removesuffix("(*)").rstrip().partition("\t")
        name, version = package.split()[:2]
        version = version.lstrip("v")
        if name.startswith("galley"):
            continue
        found[(name, version)] = (licence.strip() or "unknown", where[(name, version)])
    return [(name, version, licence, path) for (name, version), (licence, path) in sorted(found.items())]


def licence_texts(directory):
    return sorted(p for p in directory.iterdir() if p.is_file() and LICENCE_FILE.match(p.name))


def grammars():
    built = glob.glob(str(TARGET / "release/build/galley-*/out/grammar-notices.md"))
    if not built:
        sys.exit("third-party: no grammar listing: build the release binary first")
    newest = max(built, key=os.path.getmtime)
    extra = (ROOT / "crates/app/grammar-notices-extra.md").read_text()
    return Path(newest).read_text().strip() + "\n\n" + extra.strip() + "\n"


def notices():
    parts = [
        "# Third-party notices\n",
        "The Galley binary is MIT (LICENSE) and is built with the crates and syntax grammars "
        "below, under their own licences. GTK, Pango, Cairo, GLib and gdk-pixbuf are linked "
        "dynamically from the system and are not distributed with it. Generated by "
        "`scripts/third-party`; the gate checks it is current.\n",
        "## Rust crates\n",
        "| Crate | Version | Licence |",
        "|---|---|---|",
    ]
    listed = crates()
    by_text = {}
    for name, version, licence, path in listed:
        parts.append(f"| {name} | {version} | {licence} |")
        files = licence_texts(path)
        for file in files:
            text = file.read_text(errors="replace").strip()
            by_text.setdefault(text, []).append(f"{name} {version} ({file.name})")
        if not files:
            by_text.setdefault(f"(No licence file in the package; its manifest says {licence}.)", []).append(f"{name} {version}")
    parts.append("\n## Crate licence texts\n")
    for text, users in sorted(by_text.items(), key=lambda item: item[1][0]):
        parts.append("### " + ", ".join(users) + "\n")
        parts.append("```text\n" + text + "\n```\n")
    parts.append("## Syntax grammars\n")
    parts.append("From bat 0.26.1 through two-face 0.5.2; the grammars left out are listed, with why, "
                 "in crates/app/grammars-excluded.txt.\n")
    parts.append(grammars())
    return "\n".join(parts).rstrip() + "\n"


def main():
    text = notices()
    if sys.argv[1:] == ["--check"]:
        if not OUT.exists() or OUT.read_text() != text:
            sys.exit("third-party: THIRD-PARTY-NOTICES.md is out of date: run scripts/in-docker scripts/third-party")
        print(f"third-party: THIRD-PARTY-NOTICES.md is current ({len(text) // 1024} KiB)")
        return
    OUT.write_text(text)
    print(f"third-party: wrote THIRD-PARTY-NOTICES.md ({len(text) // 1024} KiB)")


main()
