#!/usr/bin/env bash
# Table test for guard-wait. Exit 1 on any mismatch, or if no cases ran.
set -euo pipefail
hook="$(dirname "$0")/guard-wait"
fail=0 n=0

check() { # expected (deny|allow), command
  local got out
  out=$(jq -n --arg c "$2" '{tool_name: "Bash", tool_input: {command: $c}}' | "$hook")
  if [[ "$(jq -r '.hookSpecificOutput.permissionDecision // empty' <<<"${out:-{\}}")" == deny ]]; then
    got=deny
  else
    got=allow
  fi
  n=$((n + 1))
  if [[ "$got" != "$1" ]]; then
    echo "FAIL: expected $1, got $got: $2" >&2
    fail=1
  fi
}

# The loop that waited three hours.
check deny  'until ! pgrep -f "cargo mutants" >/dev/null && ! docker ps -q | grep -q .; do sleep 15; done; grep x log'
check deny  'while true; do sleep 1; done'
check deny  'cd /x && until grep -q done log; do sleep 20; done'
check deny  $'until test -f x\ndo\n  sleep 5\ndone'
# A timeout elsewhere in the command does not bound the loop.
check deny  'until grep -q done log; do sleep 5; done; timeout 60 cat log'
check deny  'echo timeout 60 x; while true; do sleep 1; done'
check deny  'timeout --foreground bash -c "while true; do sleep 1; done"'
check allow 'timeout 3600 bash -c "until grep -q done log; do sleep 20; done"'
check allow 'timeout -k 5 600 bash -c "while pgrep x; do sleep 2; done"'
check allow '  timeout 90s bash -c "until test -f x; do sleep 1; done"'
check allow 'scripts/wait-for 600 grep -q "mutants tested" target/m5/mutants.log'
# Loops that do not sleep, and sleeps outside loops, are not polling.
check allow 'for f in a b; do echo "$f"; done'
check allow 'while read -r line; do echo "$line"; done <file'
check allow 'sleep 1; echo done'
check allow 'git log --oneline -5'
# Words that merely contain the keywords.
check allow 'echo awhile; ./untilted; sleep 1'
check allow 'while read -r f; do ./sleeper "$f"; done <list'

if ((n == 0)); then echo "no cases ran" >&2; exit 1; fi
if ((fail)); then exit 1; fi
echo "guard-wait: $n cases ok"
