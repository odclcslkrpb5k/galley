#!/usr/bin/env bash
# Claude Code PreToolUse hook (Bash): refuse commands that bypass the git pre-push gate
# (docs/plan.md §8, "Push"). It matches command text, so it stops a convenient bypass, not a
# determined one. Cases are in .claude/hooks/test-guard-push.
set -euo pipefail

cmd=$(jq -r '.tool_input.command // ""')
reason=""

# git accepts any unambiguous prefix of a long option, so `--no-verif` is `--no-verify`.
# This also refuses `--no-verbose`, which no command here needs.
no_verify='(^|[^[:alnum:]_-])--no-v[a-z]*([^[:alnum:]_-]|$)'
# The one hooksPath command allowed, and only as the whole command: a per-line match would let
# an allowed line carry a bypass on the next one.
allowed_hooks_path='^[[:space:]]*git config core\.hooksPath \.githooks[[:space:]]*$'

if grep -qw git <<<"$cmd" && grep -qE -- "$no_verify" <<<"$cmd"; then
  reason="--no-verify (or an abbreviation of it) skips the git hooks, including the pre-push gate."
elif grep -qi 'core\.hookspath' <<<"$cmd" && ! [[ "$cmd" =~ $allowed_hooks_path ]]; then
  reason="Changing core.hooksPath bypasses the pre-push gate."
fi

if [[ -n "$reason" ]]; then
  jq -n --arg r "$reason Fix what makes scripts/check fail instead (docs/plan.md §8)." \
    '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "deny",
      permissionDecisionReason: $r}}'
fi
