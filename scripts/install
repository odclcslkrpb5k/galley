#!/usr/bin/env bash
# Installs this checkout's build for this user (docs/plan.md §10, M6): copied by install.sh (the
# piped installer, as from a release) to ~/.local/bin and ~/.local/share/applications; and,
# unless --no-default, made the default application for Markdown (text/markdown,
# text/x-markdown), the defaults it replaces recorded for --uninstall to give back.
#
#   scripts/install [--no-default] [--home DIR]     build (in the container) and install
#   scripts/install --uninstall [--home DIR]        remove both, and give Markdown back to the
#                                                   applications that had it before
#
# --home installs under another directory instead of $HOME (scripts/test-install uses it); as
# install.sh requires, an absolute path of [A-Za-z0-9/._+-].
# Nothing outside that home is touched; the only system tools used are update-desktop-database
# and xdg-mime, each only if present.
set -euo pipefail
home=$HOME default=1 uninstall=0
while (($#)); do
  case $1 in
    --no-default) default=0 ;;
    --uninstall) uninstall=1 ;;
    --home)
      # Against the caller's directory, before the cd below; XDG paths must be absolute.
      home=$(realpath -m -- "${2:?--home needs a directory}")
      shift
      ;;
    *)
      echo "usage: scripts/install [--no-default] [--uninstall] [--home DIR]" >&2
      exit 2
      ;;
  esac
  shift
done
if [[ -n "${GBK_PREBUILT:-}" ]]; then GBK_PREBUILT=$(realpath -- "$GBK_PREBUILT"); fi
cd "$(dirname "$0")/.."
bin=$home/.local/bin
apps=$home/.local/share/applications
desktop=galley.desktop
mimes=(text/markdown text/x-markdown)
# xdg-mime and update-desktop-database work on the real home: with another one, they are told
# about it through XDG_DATA_HOME and XDG_CONFIG_HOME.
export XDG_DATA_HOME=$home/.local/share XDG_CONFIG_HOME=$home/.config
have() { command -v "$1" >/dev/null 2>&1; }
# The defaults before ours, one `mime=desktop` a line, for --uninstall to give back.
previous=$XDG_DATA_HOME/galley/previous-defaults
# The name this viewer was installed under before it was Galley.
old=gbk-markdown

# forget_associations ID: removes desktop file ID from mimeapps.list; other applications'
# associations stay as they were.
forget_associations() {
  local list=$XDG_CONFIG_HOME/mimeapps.list
  [[ -f "$list" ]] || return 0
  python3 -I - "$list" "$1" <<'PY'
import sys
path, ours = sys.argv[1], sys.argv[2]
lines = []
for line in open(path, encoding="utf-8").read().splitlines():
    key, sep, value = line.partition("=")
    if sep and ours in value.split(";"):
        rest = [entry for entry in value.split(";") if entry and entry != ours]
        if not rest:
            continue
        line = key + "=" + ";".join(rest) + ";"
    lines.append(line)
open(path, "w", encoding="utf-8").write("\n".join(lines) + "\n")
PY
}

if ((uninstall)); then
  rm -f "$bin/galley" "$apps/$desktop"
  forget_associations "$desktop"
  # Given back only where ours is still the default: one chosen since is the user's.
  if [[ -f "$previous" ]] && have xdg-mime; then
    while IFS='=' read -r mime app; do
      if [[ -n "$app" && "$app" != "$desktop" &&
        "$(xdg-mime query default "$mime" 2>/dev/null || true)" == "$desktop" ]]; then
        xdg-mime default "$app" "$mime"
      fi
    done <"$previous"
  fi
  rm -rf "$(dirname "$previous")"
  if have update-desktop-database; then update-desktop-database "$apps" 2>/dev/null || true; fi
  echo "install: removed galley from $home"
  exit 0
fi

if [[ -z "${GBK_PREBUILT:-}" ]]; then
  timeout 1800 scripts/in-docker cargo build --release --locked
fi
built=${GBK_PREBUILT:-target/docker/release/galley}
# An install from before the rename (gbk-markdown): its files go, its record of the defaults
# before it becomes ours (so --uninstall still gives Markdown back to what had it then), and
# its associations are forgotten.
if [[ -e "$bin/$old" || -e "$apps/$old.desktop" || -d "$XDG_DATA_HOME/$old" ]]; then
  if [[ -f "$XDG_DATA_HOME/$old/previous-defaults" && ! -f "$previous" ]]; then
    mkdir -p "$(dirname "$previous")"
    cp "$XDG_DATA_HOME/$old/previous-defaults" "$previous"
  fi
  rm -rf "$bin/$old" "$apps/$old.desktop" "$XDG_DATA_HOME/$old"
  forget_associations "$old.desktop"
  echo "install: removed the gbk-markdown install it replaces"
fi

# The defaults before ours, recorded before anything is installed: with no default set,
# xdg-mime answers from the installed desktop files, which would soon include ours (the first
# real install recorded itself).
if ((default)) && have xdg-mime; then
  # Kept from the first install only: a second must not record ours as what was there before.
  if [[ ! -f "$previous" ]]; then
    mkdir -p "$(dirname "$previous")"
    for mime in "${mimes[@]}"; do
      app=$(xdg-mime query default "$mime" 2>/dev/null || true)
      # The old install was ours too: nothing to give back to.
      [[ "$app" == "$old.desktop" ]] && app=""
      echo "$mime=$app"
    done >"$previous"
  fi
fi
# The copying is install.sh's, the piped installer's: from a directory staged like a release.
staged=$(mktemp -d)
trap 'rm -rf "$staged"' EXIT
cp "$built" "$staged/galley"
cp "data/$desktop.in" "$staged/$desktop.in"
GBK_FROM=$staged GBK_PREFIX=$home/.local bash install.sh 2>/dev/null
made_default=0
if ((default)) && have xdg-mime; then
  xdg-mime default "$desktop" "${mimes[@]}"
  made_default=1
fi
echo "install: galley in $bin, $desktop in $apps$( ((made_default)) && echo ", default for Markdown")"
if ((default && !made_default)); then echo "install: note: no xdg-mime, so not made the default"; fi
case ":$PATH:" in *":$bin:"*) ;; *) echo "install: note: $bin is not on PATH" ;; esac
