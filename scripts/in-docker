#!/usr/bin/env bash
# Runs a command in the build container (docs/plan.md §8), building the image if needed.
#
#   scripts/in-docker cargo test -p gbk-markdown-core
#
# The repo is mounted at /work and the build runs as the host user. Cargo's registry, git and
# advisory-database caches are named volumes; build output goes to target/docker.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
tag="gbk-markdown-build:$(cat "$root/Dockerfile" "$root/rust-toolchain.toml" | sha256sum | cut -c1-16)"

# A full disk breaks more than the build (M6: scratch builds filled it, and every program on the
# machine was out of space). Refuse to start below this much free space.
min_free_kib=$((5 * 1024 * 1024))
free_kib=$(df --output=avail -k "$root" | tail -1 | tr -d ' ')
if ((free_kib < min_free_kib)); then
  echo "in-docker: only $((free_kib / 1024)) MiB free on the disk holding $root; need 5 GiB." >&2
  echo "in-docker: target/docker/debug and scratch directories under target/ can go." >&2
  exit 1
fi

if ! docker image inspect "$tag" >/dev/null 2>&1; then
  echo "in-docker: building $tag" >&2
  docker build -q -t "$tag" "$root" >&2
  # Each Dockerfile change makes a new image: the ones it replaces go.
  docker images --format '{{.Repository}}:{{.Tag}}' gbk-markdown-build | grep -vxF "$tag" |
    xargs -r docker rmi >/dev/null 2>&1 || true
fi

# Passed only when set: an empty one would build a binary calling itself "gbk-markdown ".
version=()
if [[ -n "${GBK_VERSION:-}" ]]; then version=(-e "GBK_VERSION=$GBK_VERSION"); fi

tty=()
if [[ -t 0 && -t 1 ]]; then tty=(-it); fi

# --init: PID 1 is a real init. Without it, whatever command runs first is PID 1, and xvfb-run
# as PID 1 waits forever for its X server (it hung three times in M3 before this).
exec docker run --rm --init "${tty[@]}" \
  --user "$(id -u):$(id -g)" \
  -v "$root:/work" -w /work \
  -v gbk-markdown-registry:/cargo/registry \
  -v gbk-markdown-git:/cargo/git \
  -v gbk-markdown-advisory-dbs:/cargo/advisory-dbs \
  -e HOME=/tmp \
  -e CARGO_TARGET_DIR=/work/target/docker \
  -e CARGO_TERM_COLOR="${CARGO_TERM_COLOR:-auto}" \
  -e GATE_TREE="${GATE_TREE:-}" \
  "${version[@]}" \
  "$tag" "$@"
