#!/usr/bin/env bash
# Generates the large benchmark fixtures into target/fixtures (docs/plan.md §6). Deterministic.
#
#   list-1mb.md   awesome-rust repeated: a few enormous nested lists
#   table-1mb.md  one table of ~12 000 rows
#   code-1mb.md   one fenced code block of ~25 000 lines
#   readme-200kb.md  corpus READMEs concatenated
#   one-line.md  the startup floor: a window that pays the fixed cost of the first text
#   control-words.md  scroll control: 3000 one-word paragraphs, near-zero work per frame
#   huge-line.md  one code line of 2 MB (M2 review: never reached a first frame)
#   huge-cells.md  a 50-row table with 40 KB cells (M2 review: first frame after 68 s)
#   huge-heading.md  one heading of 1 MB
#   links.md  a link filling the first lines, and far down an anchored one (smoke: --link-at)
#   missing.md  a link to an anchor that does not exist, filling the first lines (smoke:
#                clicking it shows a notice)
#   details.md  a closed <details> whose summary is the first line (smoke: --click-at)
#   copy.md     inline code starting the first line, then a code block (smoke: copying)
#   wide-table.md  a table of 100 columns and 300 rows (pieces must stay small to scroll)
#   code.md      code in several languages (named, aliased, a shell session, a language with
#                no grammar, none named, math, a line too long to highlight), long enough to
#                scroll (smoke: --wait-highlights)
#   images.md + images/  local PNG and SVG images (inline, sized, in a table, wider than the
#                view), a missing one, one that is not an image, and a remote one (smoke:
#                --offline --wait-images)
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
corpus=$root/crates/core/tests/data/corpus
out=$root/target/fixtures
mkdir -p "$out"

# Each fixture is written in full, then cut to size (piping into `head -c` would end the
# generator with SIGPIPE under pipefail).
cap() { truncate -s "<$1" "$2"; }

for _ in 1 2 3; do cat "$corpus/rust-unofficial__awesome-rust/input.md"; done >"$out/list-1mb.md"
cap 1048576 "$out/list-1mb.md"

{
  echo "# Table"
  echo
  echo "| Id | Name | Description | Status |"
  echo "|---:|:-----|:------------|:------:|"
  for ((i = 1; i <= 12000; i++)); do
    echo "| $i | item-$i | A **row** with \`code\` and a [link](https://example.com/$i) | ok |"
  done
} >"$out/table-1mb.md"
cap 1048576 "$out/table-1mb.md"

{
  echo "# Code"
  echo
  echo '```rust'
  for ((i = 1; i <= 25000; i++)); do
    echo "    let value_$i = compute($i, \"line $i\");"
  done
  echo '```'
} >"$out/code-1mb.md"
cap 1048576 "$out/code-1mb.md"

for f in sharkdp__bat sharkdp__fd junegunn__fzf jesseduffield__lazygit sindresorhus__awesome; do
  cat "$corpus/$f/input.md"
done >"$out/readme-200kb.md"
cap 204800 "$out/readme-200kb.md"

echo "One line." >"$out/one-line.md"

for ((i = 1; i <= 3000; i++)); do printf 'word\n\n'; done >"$out/control-words.md"

# A run of N copies of a character, without a pipe that could end in SIGPIPE.
run() { printf "%${2}s" '' | tr ' ' "$1"; }

{
  echo '```'
  run x 2000000
  echo
  echo '```'
} >"$out/huge-line.md"

{
  echo "| A | B |"
  echo "|---|---|"
  cell=$(run c 40000)
  for ((i = 1; i <= 50; i++)); do echo "| $i | $cell |"; done
} >"$out/huge-cells.md"

{
  printf '# '
  run h 1000000
  echo
} >"$out/huge-heading.md"

# Links for the smoke run's hit test: the first lines are one link, so a point a little inside
# the top-left of the text is on it whatever the font; the same far down, after an anchor.
{
  words=$(for ((i = 1; i <= 120; i++)); do printf 'link '; done)
  echo "[$words](#end)"
  echo
  for ((i = 1; i <= 400; i++)); do printf 'Paragraph %d of filler.\n\n' "$i"; done
  echo '<a id="end"></a>'
  echo
  echo "[$words](https://example.com/end)"
  echo
  # Enough after it that it can scroll to the top.
  for ((i = 1; i <= 100; i++)); do printf 'Trailing paragraph %d.\n\n' "$i"; done
} >"$out/links.md"

{
  printf '['
  for ((i = 1; i <= 80; i++)); do printf 'nowhere '; done
  printf '](#nowhere)\n'
} >"$out/missing.md"

# Inline code where the smoke run right-clicks (the first line's start), then a code block.
cat >"$out/copy.md" <<'MD'
`copy-me-inline-code` and then some text.

```sh
curl -fsSL https://example.com/install.sh | bash
echo done
```

| a | b |
|---|---|
| 1 | `x` |
MD

# A closed <details> first: clicking its summary must open it.
{
  echo '<details>'
  echo '<summary>Open me: a summary long enough to fill the start of the first line</summary>'
  echo
  for ((i = 1; i <= 50; i++)); do printf 'Hidden paragraph %d.\n\n' "$i"; done
  echo '</details>'
  echo
  echo 'After.'
} >"$out/details.md"

# A table of 100 short columns: each cell is a layout, so pieces are cut by cell count.
{
  printf '|'; for ((c = 1; c <= 100; c++)); do printf ' c%d |' "$c"; done; echo
  printf '|'; for ((c = 1; c <= 100; c++)); do printf -- '---|'; done; echo
  for ((r = 1; r <= 300; r++)); do
    printf '|'; for ((c = 1; c <= 100; c++)); do printf ' %d |' "$((r * c))"; done; echo
  done
} >"$out/wide-table.md"

# Images. PNGs are written by Python's zlib (run isolated: -I).
mkdir -p "$out/images"
python3 -I - "$out/images" <<'PY'
import struct, sys, zlib
def png(path, width, height, pixel):
    rows = b"".join(b"\x00" + b"".join(pixel(x, y) for x in range(width)) for y in range(height))
    def chunk(kind, data):
        return struct.pack(">I", len(data)) + kind + data + struct.pack(">I", zlib.crc32(kind + data))
    header = struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0)
    with open(path, "wb") as f:
        f.write(b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", header) + chunk(b"IDAT", zlib.compress(rows)) + chunk(b"IEND", b""))
png(sys.argv[1] + "/blue.png", 120, 60, lambda x, y: bytes((40, 90, 200 + y // 2)))
png(sys.argv[1] + "/wide.png", 1600, 200, lambda x, y: bytes((x % 256, 160, 80)))
PY
cat >"$out/images/badge.svg" <<'SVG'
<svg xmlns="http://www.w3.org/2000/svg" width="90" height="20"><rect width="90" height="20" fill="#4c1"/><text x="8" y="14" font-size="11" fill="#fff">passing</text></svg>
SVG
echo "not an image" >"$out/images/notes.txt"
cat >"$out/images.md" <<'MD'
# Images

Inline ![small](images/blue.png) in text, a badge <img src="images/badge.svg" alt="badge">, and a missing ![gone](images/missing.png).

![wide](images/wide.png)

<img src="images/blue.png" width="80" height="40" alt="sized">

| Who | Picture |
|---|---|
| Ann | ![ann](images/blue.png) |

![remote](https://example.com/x.png) and ![not an image](images/notes.txt)
MD
# Long enough to scroll, with images further down (requested only once scrolling stops).
for ((i = 1; i <= 120; i++)); do
  printf 'Filler paragraph %d.\n\n' "$i"
  if ((i % 30 == 0)); then printf '![later %d](images/blue.png)\n\n' "$i"; fi
done >>"$out/images.md"

cat >"$out/code.md" <<'MD'
# Code

```rust
// A comment, and a struct.
struct Point { x: f64, y: f64 }

fn main() {
    let p = Point { x: 1.0, y: 2.0 };
    println!("{} {}", p.x, p.y); // 42
}
```

```shell
for f in *.md; do echo "$f"; done # list
```

```console
$ cargo build --release
   Compiling galley v0.1.0
% ls -l target
```

```toml
[package]
name = "galley"
version = "0.1.0"
```

```jsx
const App = () => <div className="x">{1 + 2}</div>;
```

```powershell
Get-ChildItem | Where-Object { $_.Length -gt 1kb }
```

```
no language: plain
```

```math
e^{i\pi} + 1 = 0
```
MD
{
  echo '```python'
  echo 'print("before the long line")'
  run x 5000
  echo
  echo 'print("after it: plain")'
  echo '```'
  echo
  # Long enough to scroll past the 16 KiB read ahead of what is laid out, so colours arrive
  # while scrolling.
  echo '```rust'
  for ((i = 1; i <= 1500; i++)); do printf 'fn f%d() -> u32 { %d } // %d\n' "$i" "$i" "$i"; done
  echo '```'
} >>"$out/code.md"

ls -l "$out"
