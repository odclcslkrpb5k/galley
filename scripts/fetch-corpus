#!/usr/bin/env bash
# Fetch the GitHub rendering corpus used as a fidelity oracle (docs/plan.md §9, oracle 3).
#
# For each repo: the README at a pinned commit, GitHub's own rendered HTML of it, its licence
# (and NOTICE, if it has one),
# and a SOURCE.toml recording where it came from. Synthetic inputs (directories starting with
# "_synthetic-") are ours. They are rendered as GitHub's repository file view renders them, which
# means they must be committed and pushed first. POST /markdown is not used: it skips alerts, math
# and emoji, and renders front matter as a heading (checked 2026-10-11).
#
# Requires an authenticated `gh`. Re-running refetches at the current HEAD of each repo, so the
# expected outputs change: review the diff before committing.
set -euo pipefail
cd "$(dirname "$0")/.."
out=crates/core/tests/data/corpus

repos=(
  rust-lang/rust BurntSushi/ripgrep sharkdp/bat sharkdp/fd tokio-rs/tokio
  sindresorhus/awesome rust-unofficial/awesome-rust facebook/react microsoft/vscode
  denoland/deno astral-sh/uv astral-sh/ruff junegunn/fzf ohmyzsh/ohmyzsh
  jesseduffield/lazygit nushell/nushell microsoft/TypeScript pallets/flask psf/requests
  tauri-apps/tauri alacritty/alacritty
)
allowed_licences=" MIT Apache-2.0 BSD-2-Clause BSD-3-Clause Unlicense CC0-1.0 "
today=$(date -u +%Y-%m-%d)

# GitHub signs uploaded-image URLs with a 5-minute JWT per fetch. Strip it: it makes the oracle
# change on every fetch, and a token issued to the fetching account does not belong in the repo.
strip_tokens() { sed -E 's/(private-user-images\.githubusercontent\.com[^"?]*)\?jwt=[^"]*/\1/g'; }

for repo in "${repos[@]}"; do
  dir="$out/${repo/\//__}"
  sha=$(gh api "repos/$repo/commits/HEAD" --jq .sha)
  # Licence detection is taken from the default branch: with ?ref= GitHub returns NOASSERTION
  # for some files it recognises without one (seen 2026-10-11 on ripgrep's UNLICENSE).
  spdx=$(gh api "repos/$repo/license" --jq .license.spdx_id)
  if [[ "$allowed_licences" != *" $spdx "* ]]; then
    echo "refusing $repo: licence $spdx is not on the allow-list" >&2
    exit 1
  fi
  mkdir -p "$dir"
  meta=$(gh api "repos/$repo/readme?ref=$sha")
  path=$(jq -r .path <<<"$meta")
  jq -r .content <<<"$meta" | base64 -d >"$dir/input.md"
  gh api -H "Accept: application/vnd.github.html+json" "repos/$repo/readme?ref=$sha" |
    strip_tokens >"$dir/github.html"
  gh api "repos/$repo/license?ref=$sha" --jq .content | base64 -d >"$dir/LICENSE"
  # Apache-2.0 §4(d): a NOTICE file the project has goes with anything taken from it.
  notice=$(gh api "repos/$repo/contents?ref=$sha" --jq '[.[].name | select(test("^NOTICE"; "i"))][0] // empty')
  if [[ -n "$notice" ]]; then
    gh api -H "Accept: application/vnd.github.raw" "repos/$repo/contents/$notice?ref=$sha" >"$dir/NOTICE"
  fi
  cat >"$dir/SOURCE.toml" <<TOML
repo = "$repo"
commit = "$sha"
path = "$path"
licence = "$spdx"
rendered_by = "GET /repos/$repo/readme?ref=$sha (Accept: application/vnd.github.html+json)"
fetched = "$today"
TOML
  echo "ok $repo $spdx $(wc -c <"$dir/input.md") bytes"
done

# Synthetic inputs: rendered from this repository at the pushed commit.
if [[ -n "$(git status --porcelain -- "$out")" ]]; then
  echo "commit the corpus inputs first" >&2
  exit 1
fi
git fetch -q origin main
if ! git merge-base --is-ancestor HEAD origin/main; then
  echo "push first: HEAD is not on origin/main" >&2
  exit 1
fi
self=$(gh repo view --json nameWithOwner --jq .nameWithOwner)
head=$(git rev-parse HEAD)
for dir in "$out"/_synthetic-*/; do
  dir=${dir%/}
  gh api -H "Accept: application/vnd.github.html+json" \
    "repos/$self/contents/$dir/input.md?ref=$head" | strip_tokens >"$dir/github.html"
  cat >"$dir/SOURCE.toml" <<TOML
repo = "$self (synthetic; written for this project)"
commit = "$head"
path = "$dir/input.md"
licence = "same as this repository"
rendered_by = "GET /repos/$self/contents/$dir/input.md?ref=$head (Accept: application/vnd.github.html+json)"
fetched = "$today"
TOML
  echo "ok $dir"
done

if grep -l 'jwt=' "$out"/*/github.html; then
  echo "a signed token survived stripping in the files above" >&2
  exit 1
fi
