#!/usr/bin/env bash
# Refuses to push any commit whose tree has not passed scripts/check (docs/plan.md §8).
#
# git passes one line per ref: <local ref> <local sha> <remote ref> <remote sha>.
set -euo pipefail
root=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000
refused=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  if [[ "$local_sha" == "$zero" ]]; then
    continue # deleting a remote ref
  fi
  tree=$(git rev-parse "$local_sha^{tree}")
  if [[ ! -e "$root/target/gate/$tree" ]]; then
    echo "pre-push: $local_sha has not passed the gate (tree $tree). Run scripts/check." >&2
    refused=1
  fi
done
exit "$refused"
