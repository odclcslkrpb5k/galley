#!/usr/bin/env bash
# Structural rules no compiler checks (docs/plan.md §3, §7). Runs inside the build container.
set -euo pipefail
cd "$(dirname "$0")/.."
fail=0

# Every workspace member takes the workspace lints; one that does not is silently unlinted.
for manifest in crates/*/Cargo.toml; do
  if ! grep -qzE '\[lints\][[:space:]]+workspace = true' "$manifest"; then
    echo "boundaries: $manifest lacks [lints] workspace = true" >&2
    fail=1
  fi
done

# comrak lives in one private module of core. cargo-deny refuses a direct dependency from any
# other crate, but cannot see core re-exporting comrak types; this can.
allowed=crates/core/src/parse/
# grep exits 1 for no match, which is the passing case; 2 is an error and must fail.
status=0
matches=$(grep -rnw comrak crates/*/src) || status=$?
if ((status > 1)); then
  echo "boundaries: grep failed ($status)" >&2
  exit 1
fi
# Code only: a comment may name comrak (for example "no comrak here").
code_matches=$(grep -vE '^[^:]+:[0-9]+:[[:space:]]*//' <<<"$matches" || true)
while read -r file; do
  if [[ -n "$file" && "$file" != "$allowed"* ]]; then
    echo "boundaries: $file uses comrak; only $allowed may" >&2
    fail=1
  fi
done < <(cut -d: -f1 <<<"$code_matches" | sort -u)

if ((fail)); then exit 1; fi
echo "boundaries: ok"
