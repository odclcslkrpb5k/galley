#!/usr/bin/env bash
# Sets each test binary's floor in scripts/test-floor.txt to its current number of tests, never
# lower: a floor goes down only by hand, with the reason in the commit message. Refuses to write
# anything if the tests could not be listed (a failed count once wrote a floor of 0).
#
#   scripts/raise-test-floor      (on the host: runs the count in the build container)
set -euo pipefail
cd "$(dirname "$0")/.."
floor=scripts/test-floor.txt
counts=$(timeout 900 scripts/in-docker bash -c 'cargo nextest list --locked --message-format json 2>/dev/null' |
  jq -r '."rust-suites" | to_entries[]
    | "\(.key) \([.value.testcases[] | select(.ignored | not)] | length)"') ||
  { echo "raise-test-floor: the tests could not be listed; nothing written" >&2; exit 1; }
[[ -n "$counts" ]] || { echo "raise-test-floor: no test binaries listed; nothing written" >&2; exit 1; }
new=$(mktemp)
while read -r line; do
  read -r binary min <<<"$line"
  if [[ -z "$line" || "$line" == \#* ]]; then
    echo "$line"
    continue
  fi
  count=$(awk -v b="$binary" '$1 == b { print $2 }' <<<"$counts")
  if [[ "$count" =~ ^[0-9]+$ ]] && ((count > min)); then
    echo "$binary $count"
    echo "raise-test-floor: $binary $min -> $count" >&2
  else
    echo "$line"
  fi
done <"$floor" >"$new"
mv "$new" "$floor"
